# Copie este arquivo para .env e preencha com os dados do seu cluster MongoDB Atlas.
# NUNCA faça commit do arquivo .env (ele já está no .gitignore).

# String de conexão do Atlas (Connect > Drivers). Troque <usuario>, <senha> e <cluster>.
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Nome do banco que será criado/usado
MONGO_DB=ecommerce_uk

# Memória do driver do Spark (ajuste se a máquina tiver pouca RAM)
SPARK_DRIVER_MEMORY=2g
